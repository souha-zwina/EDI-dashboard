# Copiez ce fichier vers ".env" et adaptez les valeurs.
# ".env" ne doit JAMAIS être commité dans git (voir .gitignore).

# Chemin de la base SQLite (persistante -> survit aux redémarrages/coupures)
EDI_DB_PATH=data/edi.db

# Identifiant EDI de votre propre organisation (utilisé pour déduire le
# partenaire expéditeur/destinataire dans les fichiers)
EDI_OWN_PARTNER_ID=LEARX88

# Listes de partenaires (séparées par des virgules, sans espace)
EDI_CLIENTS=RENAULTFR,VOLVOSE01,TESLAUS01,BMWDEU01,MERCEDESDE
EDI_SUPPLIERS=FRANSERV01,CABLEX0022,WIREPRO014,TERMILEC09,PLASTIK01

# Démarrage automatique du watcher avec l'application (recommandé : true)
EDI_AUTO_START_WATCHER=true

# Durée de vie du cache des données affichées (secondes)
EDI_DATA_CACHE_TTL=15

# Durée avant expiration de session (minutes) - usage futur / documentation
EDI_SESSION_TIMEOUT_MINUTES=120
